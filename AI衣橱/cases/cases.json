  "cases": [
    {
      "id": "A01",
      "type": "recognition",
      "title": "白衬衫平铺，光线充足",
      "input": {
        "image": "fixtures/A01_shirt.jpg",
        "hint": "平铺于浅色桌面，正面朝上",
        "image_status": "pending"
      },
      "expect": {
        "category": "top",
        "sub_in": [
          "衬衫",
          "shirt"
        ],
        "color_in": [
          "白色",
          "白"
        ],
        "formality_range": [
          2,
          4
        ],
        "confidence_gte": 0.8
      },
      "fail_policy": "NONE",
      "why_this_case": "最简单的一类，用来确认识别链路本身通，且置信度能到 0.8 以上。它挂了说明 S1 整体没接通。"
    },
    {
      "id": "A02",
      "type": "recognition",
      "title": "深灰羊毛衫，叠放 + 弱光（难例）",
      "input": {
        "image": "fixtures/A02_knit_dark.jpg",
        "hint": "夜间室内，衣服叠成方块",
        "image_status": "pending"
      },
      "expect": {
        "category": "top",
        "confidence_lt": 0.7,
        "needs_confirm": true
      },
      "fail_policy": "IN",
      "why_this_case": "验证低置信度不会硬猜，而是进待确认队列。这是 P4 约束的前置条件。"
    },
    {
